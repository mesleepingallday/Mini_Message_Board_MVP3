{
  "name": "mini-message-board-mvp3",
  "version": "3.0.0",
  "private": true,
  "description": "SQLite relational database hands-on lab",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "check:db": "node scripts/check-db.js",
    "test:db": "node --test tests/database.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:db && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
